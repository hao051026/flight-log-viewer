# ============================================================
# 飞行日志查看器 - Git 忽略规则
# ============================================================

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# ---- 依赖与构建 ----
node_modules/
npm-debug.log*
package-lock.json

# ---- 运行产物 ----
*.log
*.tmp

# ---- 测试临时文件 ----
测试/_test_*.csv
测试/临时*.csv
样例/_test_*.csv
样例/临时*.csv

# ---- 图表产物（可由软件再生成） ----
真实日志/*.png
样例/*.png
# 例外：保留 README 展示用的示例图
!样例/阿德样例图表.png

# ============================================================
# ⚠️ 不可随仓库再分发的真实日志（版权/许可原因）
# 这些文件仅用于本地测试，不纳入 Git：
#  - 阿德飞行日志.bin / 无人机样例.BIN 来自 dronekit-la-testdata
#    （无 LICENSE，按"保留所有权利"对待，禁止再分发）
# ============================================================
真实日志/阿德飞行日志.bin
真实日志/无人机样例.BIN
真实日志/多旋翼自动测试.BIN
真实日志/固定翼自动测试.BIN
真实日志/真实贝塔黑盒.BBL
真实日志/错误恢复.bbl

# ---- 本地文书 ----
*.dsh